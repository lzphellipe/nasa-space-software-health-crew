# SQLite by default; for PostgreSQL: postgresql+psycopg://crew:crew@localhost:5432/crew_health
DATABASE_URL=sqlite:///./data/crew_health.db
# auto = OSDR with fallback to the bundled copy | remote | bundled
INGEST_SOURCE=auto
INGEST_ON_STARTUP=true
# Comma-separated; "*" allows any origin (Expo dev server, dashboard)
CORS_ORIGINS=*
# When set, POST /api/v1/ingest requires the header X-API-Key
ADMIN_API_KEY=
WATCH_PCT_CHANGE=20
WATCH_Z_SCORE=2.0
BASELINE_SD_FLOOR_FRACTION=0.05
# Synthetic long-duration mission (daily vitals)
SYNTHETIC_ON_STARTUP=true
SYNTHETIC_SEED=42
# Authentication: set a long random secret; turn demo accounts off outside a demo
JWT_SECRET=change-me-to-a-long-random-value-of-at-least-32-characters
JWT_EXPIRE_MINUTES=720
SEED_DEMO_USERS=true
DEMO_PASSWORD=spaceapps2026
# Simulated mission day used as "today" (default: last day of the synthetic mission, 180)
CURRENT_MISSION_DAY=
# Pattern detection, proactive messages and human support
SCHEDULER_ENABLED=true
DETECTION_INTERVAL_MINUTES=60
PROACTIVE_MIN_INTERVAL_DAYS=7
# Optional: Slack/Teams incoming webhook that receives new support requests
SUPPORT_WEBHOOK_URL=
KNOWLEDGE_MAX_UPLOAD_MB=20
